      "targets": ["res-dev-db", "res-staging-db", "res-prod-db"],
      "target_selector": {"param": "database", "values": ["dev-db", "staging-db", "prod-db"], "closed_vocabulary": false},
      "input_schema": {"type": "object", "properties": {"database": {"type": "string"}, "query": {"type": "string"}}},
      "side_effect": true,
      "destructive": true,
      "reversible": false,
      "source": {"kind": "tool_description", "ref": "data/tools/tools-db-write.json#tool-write-db", "trusted": false}
    },
    {
