# =============================================================================
# Agent Blast-Radius Analyzer — .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- The Agent3 virtual environment (recreate with scripts/setup_env.ps1) ---
Agent3/
venv/
.venv/
env/
ENV/

# --- Secrets / local config: NEVER commit these ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*_rsa
secrets/
*.secret

# --- Analysis artifacts (regenerated by runs; results are reported in docs/) ---
artifacts/
outputs/
reports/
*.log

# --- Test / tool caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml
junit*.xml

# --- IDE / OS / agent state ---
.vscode/
.idea/
# Kilo Code worktrees live here. They are scratch checkouts of *other* projects -- the one present
# was a DPO chatbot -- so committing the directory would either publish unrelated code or, since each
# worktree carries its own .git, publish nothing but a dangling gitlink. Excluded explicitly here
# rather than relying on a parent or global ignore file, so the rule travels with this repository.
.kilo/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# --- Docker ---
.dockerignore.local
