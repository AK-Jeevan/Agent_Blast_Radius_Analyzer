# =============================================================================
# Agent Blast-Radius Analyzer — environment template
#
# Copy to `.env` and fill in locally. NEVER commit the `.env` file.
#   Copy-Item .env.example .env
#
# The analyzer is READ-ONLY by design: these variables configure the analyzer
# itself, never the environment it analyzes.
# =============================================================================

# --- Application ---
APP_ENV=development            # development | testing | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                 # true in containers, false for local console

# --- LLM reasoning layer: NVIDIA API + GLM Flash (Phase 6) ---
# Get a key at https://build.nvidia.com (NVIDIA API Catalog).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Verified id from the catalog: the GLM Flash model is `z-ai/glm-5.3-flash`.
NVIDIA_MODEL=z-ai/glm-5.3-flash
# Set to false to force the deterministic scripted stand-in (offline, reproducible, free runs).
LLM_PREFER_REAL=true

# --- Agentic loop budgets (Phase 7) ---
MAX_AGENT_STEPS=12
MAX_TOOL_CALLS=20
MAX_LLM_CALLS=15
TIMEOUT_SECONDS=90
# A run mode: A_deterministic | B_interpret | C_agentic | D_full
DEFAULT_RUN_MODE=D_full

# --- Graph / analysis bounds (Phases 2-4) ---
MAX_PATH_LENGTH=8
MAX_STATE_DEPTH=4
MAX_PATHS_PER_QUERY=200

# --- Evidence rules (Phase 5) ---
# A HIGH/CRITICAL finding needs at least this many FACT evidence items,
# otherwise it is downgraded and an `insufficient_evidence` uncertainty is added.
MIN_FACTS_FOR_HIGH_SEVERITY=2

# --- API (Phase 12) ---
API_HOST=0.0.0.0
API_PORT=8000

# --- UI (Phase 13) ---
GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860
# Where the Gradio app looks for the API.
ANALYZER_API_URL=http://127.0.0.1:8000

# --- Storage (Phase 12/17) ---
RUN_STORE_DIR=artifacts/runs
EVAL_OUTPUT_DIR=artifacts/eval
